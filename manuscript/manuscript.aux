\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Cell-type compositional dynamics along the primary TME pseudotime trajectory.} Stacked area chart showing cell-type proportions across 20 pseudotime bins along Lineage 1 (17,612 cells; root = proliferating tumor cells, terminal = alveolar parenchyma). M2-like macrophages and classical monocytes dominate intermediate pseudotime, consistent with a myeloid-enriched immunosuppressive transition zone between healthy alveolar tissue (right) and the tumor core (left). T cells and NK cells remain at consistently low proportions throughout the trajectory.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:5}{{4}{12}{\textbf {Cell-type compositional dynamics along the primary TME pseudotime trajectory.} Stacked area chart showing cell-type proportions across 20 pseudotime bins along Lineage 1 (17,612 cells; root = proliferating tumor cells, terminal = alveolar parenchyma). M2-like macrophages and classical monocytes dominate intermediate pseudotime, consistent with a myeloid-enriched immunosuppressive transition zone between healthy alveolar tissue (right) and the tumor core (left). T cells and NK cells remain at consistently low proportions throughout the trajectory}{figure.caption.12}{}}
